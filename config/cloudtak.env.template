# Written by setup.sh. Secrets are filled once. The hostname argument
# rewrites API_URL and PMTILES_URL on later runs.

CLOUDTAK_Mode=docker-compose
CLOUDTAK_Hub_URL=
CLOUDTAK_Config_media_url=http://tak_media

SigningSecret=@SIGNING_SECRET@
GARAGE_RPC_SECRET=@GARAGE_RPC_SECRET@

ASSET_BUCKET=cloudtak
AWS_S3_Endpoint=http://tak-store:3900
AWS_S3_AccessKeyId=@ACCESS_KEY@
AWS_S3_SecretAccessKey=@SECRET_KEY@
GARAGE_DEFAULT_BUCKET=cloudtak
GARAGE_DEFAULT_ACCESS_KEY=@ACCESS_KEY@
GARAGE_DEFAULT_SECRET_KEY=@SECRET_KEY@

POSTGRES=postgres://docker:docker@tak_postgis:5432/gis

API_URL=@API_URL@
PMTILES_URL=@PMTILES_URL@

# Extra hosts for MapLibre img/connect (CSV). Default CSP only covers map/tiles
# under your parent domain. Add remote basemap CDNs here.
# Explicit hosts only (no https://*.google.com — CSP wildcards easy to mess up).
# T.Rex hillshade/sprites + Google slippy (mt*/mts*/khms*):
NGINX_CSP_IMG_SRC=https://tiles.trex-arms.com,https://mt0.google.com,https://mt1.google.com,https://mt2.google.com,https://mt3.google.com,https://mts0.google.com,https://mts1.google.com,https://khms0.google.com,https://khms1.google.com,https://maps.googleapis.com,https://maps.gstatic.com
NGINX_CSP_CONNECT_SRC=https://tiles.trex-arms.com,https://mt0.google.com,https://mt1.google.com,https://mt2.google.com,https://mt3.google.com,https://mts0.google.com,https://mts1.google.com,https://khms0.google.com,https://khms1.google.com,https://maps.googleapis.com,https://maps.gstatic.com
