## Version 2026/11/14
# Written by setup.sh. Copy the result to SWAG: /config/nginx/site-confs/cloudtak.conf
# Docker network "tak". SWAG must join that network or these names never resolve.
#
# @MAP_HOST@ is CloudTAK.
# @TILES_HOST@ is CloudTAK's tile server.
# Both are one label under the hostname passed to setup.sh.
#
# SWAG Let's Encrypt covers these two names only. Do not put tak.<domain> in
# SUBDOMAINS or EXTRA_DOMAINS. ATAK uses the TAK private CA on stream ports.
# Do not copy TAK *.pem / *.p12 into /config/keys or ssl.conf.

# CloudTAK UI + same-origin PMTiles
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name @MAP_HOST@;

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    # Local PMTiles (+ optional sprites under /pmtiles/sprites/). Same host as UI.
    # proxy_buffering must stay off or a range read pulls the whole file.
    location /pmtiles/ {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        set $upstream_app tak_pmtiles.tak;
        set $upstream_port 80;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port/;
    }

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app tak_api.tak;
        set $upstream_port 5000;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}

# CloudTAK tile server
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name @TILES_HOST@;

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app tak_tiles.tak;
        set $upstream_port 5002;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
