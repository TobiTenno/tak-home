{
  "name": "T.Rex KS-MO",
  "url": "https://@MAP_HOST@/pmtiles/ks-mo-features.pmtiles",
  "protocol": "pmtiles",
  "type": "vector",
  "overlay": false,
  "minzoom": 0,
  "maxzoom": 13,
  "attribution": "© OpenStreetMap contributors | © OpenMapTiles | Meta, WRI | Copernicus | Microsoft building heights | NRCan | INEGI | T.REX ARMS Maps",
  "styles": [
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": { "fill-color": "#a8c6df" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "paint": { "fill-color": "#d5e3c4", "fill-opacity": 0.7 }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "paint": { "line-color": "#b8a48a", "line-width": 1 }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "layout": { "text-field": ["get", "name"], "text-size": 12 }
    }
  ]
}
